# Copy to .env (git-ignored) and fill in. Environment variables override this file.
# Demo kullanıcıların parolası (zorunlu): 12–128 karakter, kullanıcı adına eşit olmayan,
# yaygın olmayan bir değer. Bu dosyaya gerçek bir parola yazmayın.
DEMO_PASSWORD=

# true: oturum çerezi yalnızca HTTPS üzerinden gönderilir (yerel HTTP'de false bırakın).
LEAVE_COOKIE_SECURE=false
